# Merge these entries into the CMDA server environment when ready.
# This file is documentation, not an active environment file.
DISPATCH_INTEGRATION_ENABLED=false
# Dispatch origin only, with no /api suffix. HTTPS in production.
DISPATCH_API_URL=https://dispatch.example.com
# Same value as Dispatch CMDA_SYNC_SECRET (32+ random characters).
DISPATCH_SYNC_SECRET=
# A different value, matching Dispatch CMDA_FEEDBACK_SECRET.
DISPATCH_FEEDBACK_SECRET=
# The existing worker entry point sets PROCESS_ROLE=worker.
